{
  "name": "learning-app",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "api": "json-server --watch server/db.json --port 3000 --delay 300",
    "api:reset": "node -e \"require('fs').copyFileSync('server/db.seed.json', 'server/db.json')\"",
    "dev": "concurrently -n api,web -c blue,green \"npm run api\" \"npm start\""
  },
  "dependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "concurrently": "^9.2.5",
    "jsdom": "^26.1.0",
    "json-server": "^0.17.4",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vitest": "^3.2.7"
  }
}
